    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-resizable-panels": "^4.11.2",
    "tailwind-merge": "^2.3.0",
