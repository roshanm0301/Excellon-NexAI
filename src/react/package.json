{
  "name": "excellon-nexai-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:chrome": "playwright test --project=chrome",
    "e2e:integration": "playwright test --config playwright.integration.config.ts --project=chrome-integration"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gorules/jdm-editor": "^1.51.0",
    "@gorules/zen-engine-wasm": "^0.23.0",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.1",
    "@mui/x-data-grid-pro": "^9.6.0",
    "@mui/x-license": "^9.6.0",
    "@tanstack/react-query": "^5.40.0",
    "ace-builds": "^1.43.6",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-ace": "^14.0.1",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.24.0",
    "ts-pattern": "^5.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
